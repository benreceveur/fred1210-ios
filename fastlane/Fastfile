# Fastlane configuration for fred1210-ios.
#
# Authentication: we use an App Store Connect API key (ASC) rather than
# Apple ID + 2FA. Set these environment variables (or load from keychain):
#
#   APP_STORE_CONNECT_API_KEY_ID        — 10-char key ID from ASC
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID — UUID from ASC Users and Access -> Keys
#   APP_STORE_CONNECT_API_KEY_KEY       — contents of the .p8 file (multiline)
#
# If running locally without the API key, fastlane will fall back to
# interactive Apple ID login (may prompt for 2FA code).
#
# Lanes:
#   fastlane test       — build + run XCTest suite
#   fastlane archive    — produce a signed Release archive (no upload)
#   fastlane beta       — archive + upload to TestFlight
#
# All lanes regenerate the Xcode project with xcodegen before running.

require "shellwords"

def load_fastlane_env_file
  env_path = File.expand_path(".env.local", __dir__)
  return unless File.exist?(env_path)

  File.readlines(env_path).each do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#") || !stripped.include?("=")

    key, value = stripped.split("=", 2)
    ENV[key] ||= value.gsub(/\A["']|["']\z/, "")
  end
end

load_fastlane_env_file

default_platform(:ios)

BUNDLE_ID = ENV["FASTLANE_APP_IDENTIFIER"] || "com.example.fred1210"
TEAM_ID = ENV["FASTLANE_TEAM_ID"] || "TEAM_ID_HERE"
SCHEME = "Fred1210"
PROJECT = "Fred1210.xcodeproj"

platform :ios do
  before_all do
    load_keychain_secrets
    UI.message("Regenerating Xcode project via xcodegen…")
    sh "cd .. && xcodegen generate"
  end

  desc "Build and run unit tests on the iPhone 16 simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: "iPhone 16",
      skip_package_dependencies_resolution: false,
      xcargs: "-skipPackagePluginValidation -skipMacroValidation CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Archive a signed Release build (no upload)"
  lane :archive do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      output_directory: "build",
      output_name: "Fred1210.ipa",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" }
      },
      xcargs: "-skipPackagePluginValidation -skipMacroValidation",
      clean: true
    )
  end

  desc "Archive and upload to TestFlight"
  #
  # Build number is managed manually in project.yml (CURRENT_PROJECT_VERSION).
  # To bump before a release:
  #   1. Edit project.yml, increment CURRENT_PROJECT_VERSION
  #   2. Re-run fastlane beta
  # This avoids the fastlane-plugin-versioning plugin dependency.
  lane :beta do
    api_key = app_store_connect_api_key_from_env_or_nil

    # Pass the ASC API key to xcodebuild so -allowProvisioningUpdates can
    # fetch/create provisioning profiles without an Apple ID account signed
    # into Xcode. Without this, archive fails on CI runners with:
    #   "No Accounts: Add a new account in Accounts settings"
    auth_xcargs = ""
    if api_key
      require "tempfile"
      p8 = Tempfile.new(["AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}", ".p8"])
      # Normalize before writing — `security find-generic-password -w`
      # returns the value as a hex blob whenever it contains newlines
      # (which any PEM does). Writing the raw hex to .p8 made
      # xcodebuild's CryptoKit reject it with "invalidPEMDocument".
      # `normalized_app_store_connect_key_content` already detects the
      # hex-with-PEM-prefix shape and decodes it back to text.
      p8.write(normalized_app_store_connect_key_content(ENV["APP_STORE_CONNECT_API_KEY_KEY"]))
      p8.close
      auth_xcargs = " -authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID'].shellescape}" \
                    " -authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'].shellescape}" \
                    " -authenticationKeyPath #{p8.path.shellescape}"
    end

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      output_directory: "build",
      output_name: "Fred1210.ipa",
      export_method: "app-store",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation -allowProvisioningUpdates" + auth_xcargs,
      clean: true
    )

    if api_key
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/Fred1210.ipa",
        groups: testflight_groups,
        skip_waiting_for_build_processing: ENV["TESTFLIGHT_SKIP_WAITING"] == "true",
        changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Internal build"
      )
    else
      upload_to_testflight_with_altool
    end
  end

  def load_keychain_secrets
    {
      "APPLE_APP_SPECIFIC_PASSWORD" => "FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD",
      "APP_STORE_CONNECT_API_KEY_ID" => "APP_STORE_CONNECT_API_KEY_ID",
      "APP_STORE_CONNECT_API_KEY_ISSUER_ID" => "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY_KEY" => "APP_STORE_CONNECT_API_KEY_KEY"
    }.each do |keychain_account, env_name|
      next if ENV[env_name] && !ENV[env_name].strip.empty?

      value = sh(
        "security find-generic-password -s fred1210-ios -a #{keychain_account.shellescape} -w 2>/dev/null || true",
        log: false
      ).strip
      ENV[env_name] = value unless value.empty?
    end
  end

  def app_store_connect_api_key_from_env_or_nil
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content = normalized_app_store_connect_key_content(ENV["APP_STORE_CONNECT_API_KEY_KEY"])
    # Treat empty strings as absent — keychain `security find-generic-password`
    # prints nothing to stdout when the item is missing, and `$(...)` captures
    # that as an empty string, not nil.
    return nil if key_id.nil? || key_id.strip.empty?
    return nil if issuer_id.nil? || issuer_id.strip.empty?
    return nil if key_content.nil? || key_content.strip.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )
  end

  def normalized_app_store_connect_key_content(value)
    return nil if value.nil?

    stripped = value.strip
    return "" if stripped.empty?

    if stripped.match?(/\A[0-9a-fA-F]+\z/) && stripped.start_with?("2d2d2d2d2d")
      stripped = [stripped].pack("H*")
    end

    stripped.gsub("\\n", "\n")
  end

  def testflight_groups
    (ENV["TESTFLIGHT_GROUPS"] || "Ben's Testing,Fred Recovery Link")
      .split(",")
      .map(&:strip)
      .reject(&:empty?)
  end

  def upload_to_testflight_with_altool
    username = ENV["FASTLANE_APPLE_ID"] || ENV["FASTLANE_USER"]
    password = ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
    apple_id = ENV["APP_STORE_APPLE_ID"]
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || File.expand_path("../build/Fred1210.ipa", __dir__)

    UI.user_error!("FASTLANE_APPLE_ID must be set in fastlane/.env.local or the environment") if username.nil? || username.strip.empty?
    UI.user_error!("FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD must be set or available in Keychain") if password.nil? || password.strip.empty?
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    ENV["ALTOOL_PASSWORD"] = password
    command = [
      "xcrun altool --upload-package",
      ipa_path.shellescape,
      "--username", username.shellescape,
      "--password", "@env:ALTOOL_PASSWORD",
      "--wait"
    ]
    command.push("--apple-id", apple_id.shellescape) if apple_id && !apple_id.strip.empty?
    sh(command.join(" "))
  end
end
